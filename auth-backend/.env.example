MOBILE_AUTH_DB_NAME=<database-name>
MOBILE_AUTH_DB_USER=<database-user>
MOBILE_AUTH_DB_PASSWORD=<strong-database-password>
MOBILE_AUTH_JWT_SECRET=<at-least-32-random-characters>
MOBILE_AUTH_ACCESS_TOKEN_TTL=<positive-duration-for-example-15m>
MOBILE_AUTH_REFRESH_TOKEN_TTL=<positive-duration-for-example-720h>
MOBILE_AUTH_BCRYPT_COST=<integer-10-through-15>
MOBILE_AUTH_ADMIN_TOKEN=<at-least-32-random-characters>
EMPLOYEE_SOURCE_URL=<https-employee-source-url>
EMPLOYEE_SOURCE_TOKEN=<employee-source-token>
INITIAL_EMPLOYEE_PASSWORD=<temporary-policy-compliant-password>
